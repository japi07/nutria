{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oportunidad de desarrollo",
  "type": "object",
  "required": [
    "titulo",
    "problema",
    "especie",
    "etapa",
    "mecanismo",
    "candidatos",
    "tipo_producto",
    "ruta_regulatoria_preliminar",
    "evidencia_resumen",
    "lagunas",
    "novedad"
  ],
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 8
    },
    "problema": {
      "type": "string",
      "description": "Problema productivo o fisiológico, con su carga estimada y fuente o etiqueta."
    },
    "especie": {
      "$ref": "#/$defs/texto_especifico",
      "minLength": 3,
      "description": "Especie diana concreta (p. ej. 'vacuno lechero'), nunca genérica ('animales', 'varias', 'todas')."
    },
    "etapa": {
      "$ref": "#/$defs/texto_especifico",
      "minLength": 3,
      "description": "Etapa productiva concreta (p. ej. periodo de transición, cebo, destete), nunca genérica ('todas', 'cualquiera')."
    },
    "raza": {
      "anyOf": [
        {
          "const": "no_consta"
        },
        {
          "$ref": "#/$defs/texto_especifico",
          "minLength": 2
        }
      ],
      "description": "Raza o tipo genético diana; 'no_consta' si no se ha definido."
    },
    "estado_fisiologico": {
      "anyOf": [
        {
          "const": "no_consta"
        },
        {
          "$ref": "#/$defs/texto_especifico",
          "minLength": 3
        }
      ],
      "description": "Estado fisiológico diana (p. ej. multíparas sanas en el preparto); 'no_consta' si no se ha definido."
    },
    "mecanismo": {
      "type": "string"
    },
    "candidatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tipo_producto": {
      "enum": [
        "ingrediente",
        "combinacion",
        "mezcla_lipidica",
        "complejo_mineral",
        "compuesto_bioactivo",
        "aditivo",
        "premezcla",
        "formulacion_protegida",
        "liberacion_controlada",
        "multimecanismo",
        "otro"
      ]
    },
    "ruta_regulatoria_preliminar": {
      "enum": [
        "materia_prima",
        "aditivo_tecnologico",
        "aditivo_sensorial",
        "aditivo_nutricional",
        "aditivo_zootecnico",
        "pienso_dietetico",
        "fuera_de_alcance_medicamento",
        "fuera_de_alcance_biocida",
        "indeterminada",
        "aditivo_coccidiostatico_histomonostato",
        "pienso_complementario",
        "pienso_compuesto",
        "premezcla"
      ],
      "description": "Clasificación preliminar (docs/REGULACION_UE.md). La propone regulacion-seguridad en el triage y se actualiza con `nutria oportunidad clasificar`; las rutas fuera_de_alcance_* bloquean automáticamente la compuerta regulatoria."
    },
    "evidencia_resumen": {
      "type": "string"
    },
    "lagunas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "novedad": {
      "type": "object",
      "required": [
        "literatura",
        "patentes",
        "productos"
      ],
      "properties": {
        "literatura": {
          "type": "string"
        },
        "patentes": {
          "type": "string"
        },
        "productos": {
          "type": "string"
        }
      }
    },
    "hipotesis_iniciales": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "justificacion": {
      "type": "string"
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "destino_digestivo": {
      "type": "object",
      "properties": {
        "fraccion_escape_ruminal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "digestibilidad_intestinal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fuente_o_calculo": {
          "type": "string"
        },
        "comentario": {
          "type": "string"
        }
      }
    },
    "alegacion_prevista": {
      "type": "object",
      "description": "Alegación que se prevé hacer en el etiquetado o la presentación (Reglamento (CE) 767/2009, art. 13). Un pienso no puede alegar que previene, trata o cura enfermedades (art. 13.3).",
      "properties": {
        "texto": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "enum": [
            "funcional",
            "finalidad_nutricional_especifica",
            "ninguna"
          ],
          "description": "funcional: art. 13.1 (objetiva, comprobable y con justificación científica); finalidad_nutricional_especifica: art. 13.2, solo piensos dietéticos (Reglamento (UE) 2020/354); ninguna: sin alegación."
        },
        "fundamento": {
          "type": "string",
          "description": "Justificación científica prevista o pendiente ([DESC])."
        }
      },
      "required": [
        "texto",
        "tipo"
      ],
      "additionalProperties": false
    },
    "grupo_funcional": {
      "enum": [
        "tecnologico.conservantes",
        "tecnologico.antioxidantes",
        "tecnologico.emulgentes",
        "tecnologico.estabilizantes",
        "tecnologico.espesantes",
        "tecnologico.gelificantes",
        "tecnologico.aglutinantes",
        "tecnologico.control_radionucleidos",
        "tecnologico.antiaglomerantes",
        "tecnologico.reguladores_acidez",
        "tecnologico.aditivos_ensilado",
        "tecnologico.desnaturalizantes",
        "tecnologico.reduccion_micotoxinas",
        "tecnologico.potenciadores_condiciones_higienicas",
        "tecnologico.otros_tecnologicos",
        "sensorial.colorantes",
        "sensorial.aromatizantes",
        "nutricional.vitaminas",
        "nutricional.oligoelementos",
        "nutricional.aminoacidos",
        "nutricional.urea",
        "zootecnico.digestibilidad",
        "zootecnico.estabilizadores_flora_intestinal",
        "zootecnico.medio_ambiente",
        "zootecnico.otros_zootecnicos",
        "zootecnico.estabilizadores_condiciones_fisiologicas",
        "coccidiostatico_histomonostato"
      ],
      "description": "Categoría y grupo funcional de aditivo del anexo I del Reglamento (CE) 1831/2003, cuando aplique (nombres abreviados como en docs/REGULACION_UE.md; comprueba el texto consolidado vigente). Debe corresponder a la categoría de la ruta aditivo_*."
    },
    "situacion": {
      "enum": [
        "autorizado",
        "catalogado",
        "registrado",
        "nuevo",
        "desconocido"
      ],
      "description": "autorizado: figura en el Registro de aditivos de la UE para esa especie y condiciones; catalogado: materia prima del Catálogo (Reglamento (UE) 68/2013); registrado: en el Registro de materias primas; nuevo: requiere autorización o notificación; desconocido: sin comprobar."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "alegacion_prevista"
        ],
        "properties": {
          "alegacion_prevista": {
            "required": [
              "tipo"
            ],
            "properties": {
              "tipo": {
                "const": "finalidad_nutricional_especifica"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ruta_regulatoria_preliminar": {
            "const": "pienso_dietetico",
            "x-mensaje": "una alegación de finalidad nutricional específica solo cabe en un pienso dietético (ruta pienso_dietetico; Reglamento (UE) 2020/354)"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ruta_regulatoria_preliminar",
          "grupo_funcional"
        ],
        "properties": {
          "ruta_regulatoria_preliminar": {
            "const": "aditivo_tecnologico"
          }
        }
      },
      "then": {
        "properties": {
          "grupo_funcional": {
            "pattern": "^tecnologico\\.",
            "x-mensaje": "la ruta aditivo_tecnologico exige un grupo funcional de la categoría 'tecnologico'"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ruta_regulatoria_preliminar",
          "grupo_funcional"
        ],
        "properties": {
          "ruta_regulatoria_preliminar": {
            "const": "aditivo_sensorial"
          }
        }
      },
      "then": {
        "properties": {
          "grupo_funcional": {
            "pattern": "^sensorial\\.",
            "x-mensaje": "la ruta aditivo_sensorial exige un grupo funcional de la categoría 'sensorial'"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ruta_regulatoria_preliminar",
          "grupo_funcional"
        ],
        "properties": {
          "ruta_regulatoria_preliminar": {
            "const": "aditivo_nutricional"
          }
        }
      },
      "then": {
        "properties": {
          "grupo_funcional": {
            "pattern": "^nutricional\\.",
            "x-mensaje": "la ruta aditivo_nutricional exige un grupo funcional de la categoría 'nutricional'"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ruta_regulatoria_preliminar",
          "grupo_funcional"
        ],
        "properties": {
          "ruta_regulatoria_preliminar": {
            "const": "aditivo_zootecnico"
          }
        }
      },
      "then": {
        "properties": {
          "grupo_funcional": {
            "pattern": "^zootecnico\\.",
            "x-mensaje": "la ruta aditivo_zootecnico exige un grupo funcional de la categoría 'zootecnico'"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ruta_regulatoria_preliminar",
          "grupo_funcional"
        ],
        "properties": {
          "ruta_regulatoria_preliminar": {
            "const": "aditivo_coccidiostatico_histomonostato"
          }
        }
      },
      "then": {
        "properties": {
          "grupo_funcional": {
            "const": "coccidiostatico_histomonostato",
            "x-mensaje": "la ruta aditivo_coccidiostatico_histomonostato solo admite el grupo coccidiostatico_histomonostato"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ruta_regulatoria_preliminar"
        ],
        "properties": {
          "ruta_regulatoria_preliminar": {
            "enum": [
              "materia_prima",
              "indeterminada",
              "fuera_de_alcance_medicamento",
              "fuera_de_alcance_biocida"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "grupo_funcional"
          ]
        },
        "x-mensaje": "grupo_funcional solo se indica con una ruta de aditivo, premezcla, pienso complementario, compuesto o dietético"
      }
    }
  ],
  "$defs": {
    "texto_informado": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[­͏؜ᅟᅠ឴឵᠋-᠎​-‏‪-‮⁠-⁤⁪-⁯ㅤ︀-️﻿ﾠ])(?![\\s\\S]*[！-～])(?![^\\w%‰]*$)(?!(?i:[\\W_]*(?:(\\w)\\1+|x|0|xyz|[aá]bc|[aá]sdf|f[oó][oó]|b[aá]r|t[eé]st|pr[uúü][eé]b[aá]|pl[aá]c[eé]h[oó]ld[eé]r|l[oó]r[eé]m[\\W_]+[ií]ps[uúü]m|n[\\W_]?[aádcprs][\\W_]?|ns[\\W_]?/?[\\W_]?nc[\\W_]?|s[\\W_]?/?[\\W_]?d[\\W_]?|tb[dcaá]|n[uúü]ll|n[oó]n[eé]|n[ií]l|n[aá]n|[uúü]nd[eé]f[ií]n[eé]d|[uúü]nkn[oó]wn|[uúü]nk|n[\\W_]?/[\\W_]?k|m[ií]ss[ií]ng|p[eé]nd[ií]ng|d[ií]tt[oó]|[ií]d[eé]m|[ií]d\\.|p[eé]nd[ií][eé]nt[eé]s?|d[eé]sc[oó]n[oó]c[ií]d[oóaá]s?|[ií]gn[oó]r[aá]d[oóaá]s?|n[oó][\\W_]*c[oó]nst[aá]|n[aá]d[aá]|v[aá]c[ií][oóaá]s?|n[ií]ng[uúü]n[oóaá]s?|n[ií]ng[uúü]n|n[oó][\\W_]+s[eé][\\W_]+(?:s[aá]b[eé]|c[oó]n[oó]c[eé]|[ií]nd[ií]c[aá]|[ií]nf[oó]rm[aá]|[eé]sp[eé]c[ií]f[ií]c[aá]|d[eé]scr[ií]b[eé]|r[eé]p[oó]rt[aá]|p[uúü]bl[ií]c[aá]|d[eé]t[aá]ll[aá]|m[eé]nc[ií][oó]n[aá]|pr[eé]c[ií]s[aá])|n[oó][\\W_]+(?:[ií]nd[ií]c[aá]d|[ií]nf[oó]rm[aá]d|r[eé]p[oó]rt[aá]d|p[uúü]bl[ií]c[aá]d|d[eé]scr[ií]t|[eé]sp[eé]c[ií]f[ií]c[aá]d|d[eé]f[ií]n[ií]d|d[eé]t[eé]rm[ií]n[aá]d|c[oó]n[oó]c[ií]d|d[eé]cl[aá]r[aá]d|d[eé]t[aá]ll[aá]d|r[eé]g[ií]str[aá]d|m[eé]nc[ií][oó]n[aá]d|f[aá]c[ií]l[ií]t[aá]d|pr[oó]p[oó]rc[ií][oó]n[aá]d|pr[eé]c[ií]s[aá]d|[ií]d[eé]nt[ií]f[ií]c[aá]d|d[ií]sp[oó]n[ií]bl|[aá]pl[ií]c[aá]bl)[oóaáeé]s?|n[oó][\\W_]+(?:[aá]pl[ií]c[aá]|pr[oó]c[eé]d[eé]|c[oó]rr[eé]sp[oó]nd[eé]|r[eé]l[eé]v[aá]nt[eé]|d[ií]sp[oó]n[ií]bl[eé])|s[ií]n[\\W_]+(?:d[aá]t[oó]s?|[ií]nf[oó]rm[aá]c[ií][oó]n|[eé]sp[eé]c[ií]f[ií]c[aá]r|d[eé]f[ií]n[ií]r|d[eé]t[eé]rm[ií]n[aá]r|[ií]nd[ií]c[aá]r|[ií]nf[oó]rm[aá]r|pr[eé]c[ií]s[aá]r|d[eé]t[aá]ll[aá]r|c[oó]ncr[eé]t[aá]r|[ií]d[eé]nt[ií]f[ií]c[aá]r|d[eé]scr[ií]b[ií]r|cl[aá]s[ií]f[ií]c[aá]r|v[aá]l[oó]r(?:[eé]s)?)|(?:[aá]|p[oó]r)[\\W_]+(?:d[eé]f[ií]n[ií]r|d[eé]t[eé]rm[ií]n[aá]r|c[oó]ncr[eé]t[aá]r|[eé]sp[eé]c[ií]f[ií]c[aá]r|c[oó]nf[ií]rm[aá]r|pr[eé]c[ií]s[aá]r|c[oó]mpl[eé]t[aá]r|r[eé]ll[eé]n[aá]r)|v[eé]r[\\W_]+(?:[aá]rr[ií]b[aá]|[aá]b[aá]j[oó]|t[eé]xt[oó]|[aá]rt[ií]c[uúü]l[oó]|f[uúü][eé]nt[eé]|n[oó]t[aá]s?)|n[oó]t[\\W_]+(?:r[eé]p[oó]rt[eé]d|st[aá]t[eé]d|g[ií]v[eé]n|[aá]v[aá][ií]l[aá]bl[eé]|[aá]ppl[ií]c[aá]bl[eé]|sp[eé]c[ií]f[ií][eé]d|d[eé]scr[ií]b[eé]d|kn[oó]wn|d[eé]t[eé]rm[ií]n[eé]d|d[eé]f[ií]n[eé]d|r[eé]c[oó]rd[eé]d)|[uúü]nsp[eé]c[ií]f[ií][eé]d|[uúü]nr[eé]p[oó]rt[eé]d|[uúü]n[aá]v[aá][ií]l[aá]bl[eé]|t[oó][\\W_]+b[eé][\\W_]+(?:d[eé]t[eé]rm[ií]n[eé]d|d[eé]f[ií]n[eé]d|c[oó]nf[ií]rm[eé]d))[\\W_]*$))[\\s\\S]+$",
      "x-mensaje": "texto vacío, solo de signos, con caracteres invisibles o de relleno ('', '-', 'n/a', 'xxx', 'desconocido', 'not reported'...): escribe el dato o, si el campo es obligatorio y el estudio no lo publica, déjalo a null y decláralo en 'no_consta'",
      "description": "Texto con contenido: no vacío, no solo signos, sin caracteres invisibles ni de ancho completo y sin valores de relleno (n/a, nd, s/d, desconocido, pendiente, sin datos, not reported...), con independencia de mayúsculas, tildes y signos."
    },
    "texto_especifico": {
