{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oportunidad de desarrollo",
  "type": "object",
  "required": [
    "titulo",
    "problema",
    "especie",
    "etapa",
    "mecanismo",
    "candidatos",
    "tipo_producto",
    "ruta_regulatoria_preliminar",
    "evidencia_resumen",
    "lagunas",
    "novedad"
  ],
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 8
    },
    "problema": {
      "type": "string",
      "description": "Problema productivo o fisiológico, con su carga estimada y fuente o etiqueta."
    },
    "especie": {
      "type": "string"
    },
    "etapa": {
      "type": "string",
      "description": "Etapa productiva (p. ej. periodo de transición, cebo, destete)."
    },
    "mecanismo": {
      "type": "string"
    },
    "candidatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tipo_producto": {
      "enum": [
        "ingrediente",
        "combinacion",
        "mezcla_lipidica",
        "complejo_mineral",
        "compuesto_bioactivo",
        "aditivo",
        "premezcla",
        "formulacion_protegida",
        "liberacion_controlada",
        "multimecanismo",
        "otro"
      ]
    },
    "ruta_regulatoria_preliminar": {
      "enum": [
        "materia_prima",
        "aditivo_tecnologico",
        "aditivo_sensorial",
        "aditivo_nutricional",
        "aditivo_zootecnico",
        "pienso_dietetico",
        "fuera_de_alcance_medicamento",
        "fuera_de_alcance_biocida",
        "indeterminada"
      ]
    },
    "evidencia_resumen": {
      "type": "string"
    },
    "lagunas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "novedad": {
      "type": "object",
      "required": [
        "literatura",
        "patentes",
        "productos"
      ],
      "properties": {
        "literatura": {
          "type": "string"
        },
        "patentes": {
          "type": "string"
        },
        "productos": {
          "type": "string"
        }
      }
    },
    "hipotesis_iniciales": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "justificacion": {
      "type": "string"
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "destino_digestivo": {
      "type": "object",
      "properties": {
        "fraccion_escape_ruminal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "digestibilidad_intestinal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fuente_o_calculo": {
          "type": "string"
        },
        "comentario": {
          "type": "string"
        }
      }
    }
  }
}
