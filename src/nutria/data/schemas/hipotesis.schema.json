{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipótesis científica",
  "type": "object",
  "required": [
    "titulo",
    "fenomeno",
    "mecanismo",
    "compuestos",
    "efecto_esperado",
    "efecto_minimo_relevante",
    "variables",
    "evidencia_a_favor",
    "evidencia_en_contra",
    "incertidumbres",
    "experimentos",
    "criterio_falsacion",
    "origen",
    "especie",
    "etapa"
  ],
  "properties": {
    "oportunidad": {
      "type": "string",
      "pattern": "^O-\\d{4}$"
    },
    "titulo": {
      "type": "string",
      "minLength": 8
    },
    "fenomeno": {
      "type": "string"
    },
    "mecanismo": {
      "type": "string"
    },
    "compuestos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "diana": {
      "type": "string"
    },
    "efecto_esperado": {
      "type": "string"
    },
    "efecto_minimo_relevante": {
      "type": "string",
      "description": "Diferencia mínima con relevancia biológica o económica, fijada antes de analizar."
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidencia_a_favor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidencia"
      }
    },
    "evidencia_en_contra": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidencia"
      }
    },
    "incertidumbres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experimentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "criterio_falsacion": {
      "type": "string",
      "minLength": 10
    },
    "probabilidad_previa": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "origen": {
      "enum": [
        "ia",
        "equipo_humano",
        "literatura",
        "mixto"
      ]
    },
    "tecnica_generacion": {
      "type": "string",
      "description": "p. ej. descubrimiento basado en literatura (ABC), contradicción entre estudios, reposicionamiento."
    },
    "especie": {
      "$ref": "#/$defs/texto_especifico",
      "minLength": 3,
      "description": "Especie diana concreta, nunca genérica ('animales', 'varias')."
    },
    "etapa": {
      "$ref": "#/$defs/texto_especifico",
      "minLength": 3,
      "description": "Etapa productiva o estado fisiológico concretos, nunca genéricos ('todas')."
    },
    "concentracion_activa_in_vitro": {
      "type": "string",
      "description": "Concentración a la que se observó la actividad, con unidades y fuente, o [DESC]"
    },
    "concentracion_alcanzable_in_vivo": {
      "type": "string",
      "description": "Concentración estimada en la diana a la dosis prevista (con `nutria destino ruminal` si procede), o [DESC]"
    }
  },
  "$defs": {
    "evidencia": {
      "type": "object",
      "required": [
        "afirmacion",
        "etiqueta"
      ],
      "properties": {
        "afirmacion": {
          "type": "string"
        },
        "etiqueta": {
          "enum": [
            "PUB",
            "DER",
            "HIP",
            "SUP",
            "DESC"
          ]
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nivel": {
          "enum": [
            "alta",
            "moderada",
            "baja",
            "muy_baja"
          ]
        },
        "transferibilidad": {
          "enum": [
            "especie_diana",
            "otra_especie",
            "in_vitro",
            "in_silico",
            "humano"
          ]
        }
      }
    },
    "texto_informado": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[­͏؜ᅟᅠ឴឵᠋-᠎​-‏‪-‮⁠-⁤⁪-⁯ㅤ︀-️﻿ﾠ])(?![\\s\\S]*[！-～])(?![^\\w%‰]*$)(?!(?i:[\\W_]*(?:(\\w)\\1+|x|0|xyz|[aá]bc|[aá]sdf|f[oó][oó]|b[aá]r|t[eé]st|pr[uúü][eé]b[aá]|pl[aá]c[eé]h[oó]ld[eé]r|l[oó]r[eé]m[\\W_]+[ií]ps[uúü]m|n[\\W_]?[aádcprs][\\W_]?|ns[\\W_]?/?[\\W_]?nc[\\W_]?|s[\\W_]?/?[\\W_]?d[\\W_]?|tb[dcaá]|n[uúü]ll|n[oó]n[eé]|n[ií]l|n[aá]n|[uúü]nd[eé]f[ií]n[eé]d|[uúü]nkn[oó]wn|[uúü]nk|n[\\W_]?/[\\W_]?k|m[ií]ss[ií]ng|p[eé]nd[ií]ng|d[ií]tt[oó]|[ií]d[eé]m|[ií]d\\.|p[eé]nd[ií][eé]nt[eé]s?|d[eé]sc[oó]n[oó]c[ií]d[oóaá]s?|[ií]gn[oó]r[aá]d[oóaá]s?|n[oó][\\W_]*c[oó]nst[aá]|n[aá]d[aá]|v[aá]c[ií][oóaá]s?|n[ií]ng[uúü]n[oóaá]s?|n[ií]ng[uúü]n|n[oó][\\W_]+s[eé][\\W_]+(?:s[aá]b[eé]|c[oó]n[oó]c[eé]|[ií]nd[ií]c[aá]|[ií]nf[oó]rm[aá]|[eé]sp[eé]c[ií]f[ií]c[aá]|d[eé]scr[ií]b[eé]|r[eé]p[oó]rt[aá]|p[uúü]bl[ií]c[aá]|d[eé]t[aá]ll[aá]|m[eé]nc[ií][oó]n[aá]|pr[eé]c[ií]s[aá])|n[oó][\\W_]+(?:[ií]nd[ií]c[aá]d|[ií]nf[oó]rm[aá]d|r[eé]p[oó]rt[aá]d|p[uúü]bl[ií]c[aá]d|d[eé]scr[ií]t|[eé]sp[eé]c[ií]f[ií]c[aá]d|d[eé]f[ií]n[ií]d|d[eé]t[eé]rm[ií]n[aá]d|c[oó]n[oó]c[ií]d|d[eé]cl[aá]r[aá]d|d[eé]t[aá]ll[aá]d|r[eé]g[ií]str[aá]d|m[eé]nc[ií][oó]n[aá]d|f[aá]c[ií]l[ií]t[aá]d|pr[oó]p[oó]rc[ií][oó]n[aá]d|pr[eé]c[ií]s[aá]d|[ií]d[eé]nt[ií]f[ií]c[aá]d|d[ií]sp[oó]n[ií]bl|[aá]pl[ií]c[aá]bl)[oóaáeé]s?|n[oó][\\W_]+(?:[aá]pl[ií]c[aá]|pr[oó]c[eé]d[eé]|c[oó]rr[eé]sp[oó]nd[eé]|r[eé]l[eé]v[aá]nt[eé]|d[ií]sp[oó]n[ií]bl[eé])|s[ií]n[\\W_]+(?:d[aá]t[oó]s?|[ií]nf[oó]rm[aá]c[ií][oó]n|[eé]sp[eé]c[ií]f[ií]c[aá]r|d[eé]f[ií]n[ií]r|d[eé]t[eé]rm[ií]n[aá]r|[ií]nd[ií]c[aá]r|[ií]nf[oó]rm[aá]r|pr[eé]c[ií]s[aá]r|d[eé]t[aá]ll[aá]r|c[oó]ncr[eé]t[aá]r|[ií]d[eé]nt[ií]f[ií]c[aá]r|d[eé]scr[ií]b[ií]r|cl[aá]s[ií]f[ií]c[aá]r|v[aá]l[oó]r(?:[eé]s)?)|(?:[aá]|p[oó]r)[\\W_]+(?:d[eé]f[ií]n[ií]r|d[eé]t[eé]rm[ií]n[aá]r|c[oó]ncr[eé]t[aá]r|[eé]sp[eé]c[ií]f[ií]c[aá]r|c[oó]nf[ií]rm[aá]r|pr[eé]c[ií]s[aá]r|c[oó]mpl[eé]t[aá]r|r[eé]ll[eé]n[aá]r)|v[eé]r[\\W_]+(?:[aá]rr[ií]b[aá]|[aá]b[aá]j[oó]|t[eé]xt[oó]|[aá]rt[ií]c[uúü]l[oó]|f[uúü][eé]nt[eé]|n[oó]t[a