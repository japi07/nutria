{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracción de datos de un estudio",
  "description": "Un registro por comparación (tratamiento frente a control) y por variable. Los campos obligatorios que el estudio no publica se dejan a null y se declaran en 'no_consta'. estado_verificacion y verificado_por los fija el sistema al registrar una doble extracción comparada (`extraccion comparar A B --registrar`) o conciliada (`extraccion conciliar`).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dieta_basal",
    "diseno",
    "dosis",
    "dosis_base",
    "dosis_unidad",
    "especie",
    "estado_fisiologico",
    "forma_producto",
    "fuente",
    "intervencion",
    "media_control",
    "media_tratamiento",
    "n_control",
    "n_tratamiento",
    "tipo_dispersion",
    "ubicacion",
    "unidad",
    "unidad_experimental",
    "variable"
  ],
  "properties": {
    "fuente": {
      "type": "string",
      "pattern": "^(doi|pmid|openalex):.+"
    },
    "experimento": {
      "type": "string"
    },
    "especie": {
      "$ref": "#/$defs/texto_especifico"
    },
    "raza": {
      "type": "string"
    },
    "sexo": {
      "type": "string"
    },
    "edad": {
      "type": "string"
    },
    "estado_fisiologico": {
      "anyOf": [
        {
          "$ref": "#/$defs/texto_especifico"
        },
        {
          "type": "null"
        }
      ]
    },
    "paridad": {
      "type": "string"
    },
    "diseno": {
      "enum": [
        "paralelo",
        "cuadrado_latino",
        "crossover",
        "factorial",
        "bloques",
        "otro"
      ]
    },
    "unidad_experimental": {
      "enum": [
        "animal",
        "corral",
        "jaula",
        "tanque",
        "granja",
        "otro"
      ]
    },
    "duracion_dias": {
      "type": "number",
      "minimum": 0
    },
    "dieta_basal": {
      "anyOf": [
        {
          "$ref": "#/$defs/texto_informado"
        },
        {
          "type": "null"
        }
      ]
    },
    "intervencion": {
      "$ref": "#/$defs/texto_informado"
    },
    "dosis": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dosis_unidad": {
      "anyOf": [
        {
          "$ref": "#/$defs/texto_informado"
        },
        {
          "type": "null"
        }
      ]
    },
    "dosis_base": {
      "anyOf": [
        {
          "$ref": "#/$defs/texto_informado"
        },
        {
          "type": "null"
        }
      ],
      "description": "p. ej. g/animal/d, mg/kg MS, % MS"
    },
    "forma_producto": {
      "anyOf": [
        {
          "$ref": "#/$defs/texto_informado"
        },
        {
          "type": "null"
        }
      ],
      "description": "Forma química, protección ruminal, encapsulado..."
    },
    "comparador": {
      "type": "string"
    },
    "variable": {
      "$ref": "#/$defs/texto_informado"
    },
    "unidad": {
      "$ref": "#/$defs/texto_informado"
    },
    "n_control": {
      "minimum": 1,
      "type": [
        "number",
        "null"
      ]
    },
    "n_tratamiento": {
      "minimum": 1,
      "type": [
        "number",
        "null"
      ]
    },
    "media_control": {
      "type": [
        "number",
        "null"
      ]
    },
    "media_tratamiento": {
      "type": [
        "number",
        "null"
      ]
    },
    "tipo_dispersion": {
      "enum": [
        "SD",
        "SE",
        "SEM_combinado",
        "SED",
        "IC95",
        "ninguno",
        null
      ]
    },
    "dispersion_control": {
      "type": "number",
      "minimum": 0
    },
    "dispersion_tratamiento": {
      "type": "number",
      "minimum": 0
    },
    "p_valor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ubicacion": {
      "$ref": "#/$defs/texto_informado",
      "description": "Tabla, figura (indicar si digitalizada) o página."
    },
    "financiacion": {
      "type": "string"
    },
    "conflictos": {
      "type": "string"
    },
    "estado_verificacion": {
      "enum": [
        "simple",
        "doble_concordante",
        "discrepancia",
        "resuelta"
      ],
      "description": "Lo fija el sistema: 'doble_concordante' solo sale de una comparación registrada sin discrepancias y 'resuelta' de una conciliación registrada. `extraccion agregar` solo admite 'simple'."
    },
    "verificado_por": {
      "type": "string",
      "description": "Lo fija el sistema (quién registró la comparación); no se declara a mano."
    },
    "notas": {
      "type": "string"
    },
    "forraje_pct_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "Forraje (% de la MS)",
      "minimum": 0,
      "maximum": 100
    },
    "fnd_pct_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "FND (% de la MS)",
      "minimum": 0,
      "maximum": 100
    },
    "almidon_pct_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "Almidón (% de la MS)",
      "minimum": 0,
      "maximum": 100
    },
    "grasa_pct_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "Grasa o extracto etéreo (% de la MS)",
      "minimum": 0,
      "maximum": 100
    },
    "pb_pct_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "Proteína bruta (% de la MS)",
      "minimum": 0,
      "maximum": 100
    },
    "pdr_pct_pb": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Proteína degradable en el rumen (PDR), % de la PB"
    },
    "pdr_pct_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Proteína degradable en el rumen (PDR), % de la MS (no puede superar pb_pct_ms)"
    },
    "dcad_meq_kg_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "DCAD (mEq/kg de MS)"
    },
    "eventos_control": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Animales con el evento (variables binarias)"
    },
    "eventos_tratamiento": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "hito_referencia": {
      "$ref": "#/$defs/texto_informado",
      "description": "Hito respecto al que se cuentan los días de las ventanas (p. ej. 'parto'); obligatorio si hay ventanas"
    },
    "ventana_inicio_dias": {
      "type": "number",
      "description": "Inicio de la ventana de observación o muestreo, en días respecto al hito (negativo = antes; p. ej. 0 = parto)"
    },
    "ventana_fin_dias": {
      "type": "number",
      "description": "Fin de la ventana de observación o muestreo (días respecto al hito; para un único muestreo, igual al inicio)"
    },
    "suplementacion_inicio_dias": {
      "type": "number",
      "description": "Inicio de la suplementación, en días respecto al hito (p. ej. -21 = tres semanas antes del parto)"
    },
    "suplementacion_fin_dias": {
      "type": "number",
      "description": "Fin de la suplementación, en días respecto al hito"
    },
    "definicion_caso": {
      "$ref": "#/$defs/texto_informado",
      "minLength": 5,
      "description": "Definición de caso con su umbral y matriz, p. ej. 'cetosis subclínica: BHB en sangre ≥ 1,2 mmol/L'. Obligatoria con eventos_control/eventos_tratamiento."
    },
    "no_consta": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "dieta_basal",
          "dosis",
          "dosis_base",
          "dosis_unidad",
          "estado_fisiologico",
          "forma_producto",
          "media_control",
          "media_tratamiento",
          "n_control",
          "n_tratamiento",
          "tipo_dispersion"
        ]
      },
      "description": "Campos obligatorios que el estudio no publica (se dejan a null)"
    }
  },
  "dependentRequired": {
    "ventana_inicio_dias": [
      "ventana_fin_dias",
      "hito_referencia"
    ],
    "ventana_fin_dias": [
      "ventana_inicio_dias",
      "hito_referencia"
    ],
    "suplementacion_inicio_dias": [
      "suplementacion_fin_dias",
      "hito_referencia"
    ],
    "suplementacion_fin_dias": [
      "suplementacion_inicio_dias",
      "hito_referencia"
    ]
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "eventos_control"
            ],
            "properties": {
              "eventos_control": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "eventos_tratamiento"
            ],
            "properties": {
              "eventos_tratamiento": {
                "type": "number"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "eventos_control",
          "eventos_tratamiento",
          "hito_referencia",
          "ventana_inicio_dias",
          "ventana_fin_dias",
          "definicion_caso"
        ],
        "properties": {
          "eventos_control": {
            "type": "number"
          },
          "eventos_tratamiento": {
            "type": "number"
          },
          "n_control": {
            "type": "number"
          },
          "n_tratamiento": {
            "type": "number"
          }
        },
        "x-mensaje": "una variable de incidencia (eventos) exige eventos de ambos grupos, sus n, la ventana respecto al hito (hito_referencia, ventana_inicio_dias, ventana_fin_dias) y la definición de caso con su umbral"
      }
    }
  ],
  "$defs": {
    "texto_informado": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[­͏؜ᅟᅠ឴឵᠋-᠎​-‏‪-‮⁠-⁤⁪-⁯ㅤ︀-️﻿ﾠ])(?![\\s\\S]*[！-～])(?![^\\w%‰]*$)(?!(?i:[\\W_]*(?:(\\w)\\1+|x|0|xyz|[aá]bc|[aá]sdf|f[oó][oó]|b[aá]r|t[eé]st|pr[uúü][eé]b[aá]|pl[aá]c[eé]h[oó]ld[eé]r|l[oó]r[eé]m[\\W_]+[ií]ps[uúü]m|n[\\W_]?[aádcprs][\\W_]?|ns[\\W_]?/?[\\W_]?nc[\\W_]?|s[\\W_]?/?[\\W_]?d[\\W_]?|tb[dcaá]|n[uúü]ll|n[oó]n[eé]|n[ií]l|n[aá]n|[uúü]nd[eé]f[ií]n[eé]d|[uúü]nkn[oó]wn|[uúü]nk|n[\\W_]?/[\\W_]?k|m[ií]ss[ií]ng|p[eé]nd[ií]ng|d[ií]tt[oó]|[ií]d[eé]m|[ií]d\\.|p[eé]nd[ií][eé]nt[eé]s?|d[eé]sc[oó]n[oó]c[ií]d[oóaá]s?|[ií]gn[oó]r[aá]d[oóaá]s?|n[oó][\\W_]*c[oó]nst[aá]|n[aá]d[aá]|v[aá]c[ií][oóaá]s?|n[ií]ng[uúü]n[oóaá]s?|n[ií]ng[uúü]n|n[oó][\\W_]+s[eé][\\W_]+(?:s[aá]b[eé]|c[oó]n[oó]c[eé]|[ií]nd[ií]c[aá]|[ií]nf[oó]rm[aá]|[eé]sp[eé]c[ií]f[ií]c[aá]|d[eé]scr[ií]b[eé]|r[eé]p[oó]rt[aá]|p[uúü]bl[ií]c[aá]|d[eé]t[aá]ll[aá]|m[eé]nc[ií][oó]n[aá]|pr[eé]c[ií]s[aá])|n[oó][\\W_]+(?:[ií]nd[ií]c[aá]d|[ií]nf[oó]rm[aá]d|r[eé]p[oó]rt[aá]d|p[uúü]bl[ií]c[aá]d|d[eé]scr[ií]t|[eé]sp[eé]c[ií]f[ií]c[aá]d|d[eé]f[ií]n[ií]d|d[eé]t[eé]rm[ií]n[aá]d|c[oó]n[oó]c[ií]d|d[eé]cl[aá]r[aá]d|d[eé]t[aá]ll[aá]d|r[eé]g[ií]str[aá]d|m[eé]nc[ií][oó]n[aá]d|f[aá]c[ií]l[ií]t[aá]d|pr[oó]p[oó]rc[ií][oó]n[aá]d|pr[eé]c[ií]s[aá]d|[ií]d[eé]nt[ií]f[ií]c[aá]d|d[ií]sp[oó]n[ií]bl|[aá]pl[ií]c[aá]bl)[oóaáeé]s?|n[oó][\\W_]+(?:[aá]pl[ií]c[aá]|pr[oó]c[eé]d[eé]|c[oó]rr[eé]sp[oó]nd[eé]|r[eé]l[eé]v[aá]nt[eé]|d[ií]sp[oó]n[ií]bl[eé])|s[ií]n[\\W_]+(?:d[aá]t[oó]s?|[ií]nf[oó]rm[aá]c[ií][oó]n|[eé]sp[eé]c[ií]f[ií]c[aá]r|d[eé]f[ií]n[ií]r|d[eé]t[eé]rm[ií]n[aá]r|[ií]nd[ií]c[aá]r|[ií]nf[oó]rm[aá]r|pr[eé]c[ií]s[aá]r|d[eé]t[aá]ll[aá]r|c[oó]ncr[eé]t[aá]r|[ií]d[eé]nt[ií]f[ií]c[aá]r|d[eé]scr[ií]b[ií]r|cl[aá]s[ií]f[ií]c[aá]r|v[aá]l[oó]r(?:[eé]s)?)|(?:[aá]|p[oó]r)[\\W_]+(?:d[eé]f[ií]n[ií]r|d[eé]t[eé]rm[ií]n[aá]r|c[oó]ncr[eé]t[aá]r|[eé]sp[eé]c[ií]f[ií]c[aá]r|c[oó]nf[ií]rm[aá]r|pr[eé]c[ií]s[aá]r|c[oó]mpl[eé]t[aá]r|r[eé]ll[eé]n[aá]r)|v[eé]r[\\W_]+(?:[aá]rr[ií]b[aá]|[aá]b[aá]j[oó]|t[eé]xt[oó]|[aá]rt[ií]c[uúü]l[oó]|f[uúü][eé]nt[eé]|n[oó]t[aá]s?)|n[oó]t[\\W_]+(?:r[eé]p[oó]rt[eé]d|st[aá]t[eé]d|g[ií]v[eé]n|[aá]v[aá][ií]l[aá]bl[eé]|[aá]ppl[ií]c[aá]bl[eé]|sp[eé]c[ií]f[ií][eé]d|d[eé]scr[ií]b[eé]d|kn[oó]wn|d[eé]t[eé]rm[ií]n[eé]d|d[eé]f[ií]n[eé]d|r[eé]c[oó]rd[eé]d)|[uúü]nsp[eé]c[ií]f[ií][eé]d|[uúü]nr[eé]p[oó]rt[eé]d|[uúü]n[aá]v[aá][ií]l[aá]bl[eé]|t[oó][\\W_]+b[eé][\\W_]+(?:d[eé]t[eé]rm[ií]n[eé]d|d[eé]f[ií]n[eé]d|c[oó]nf[ií]rm[eé]d))[\\W_]*$))[\\s\\S]+$",
      "x-mensaje": "texto vacío, solo de signos, con caracteres invisibles o de relleno ('', '-', 'n/a', 'xxx', 'desconocido', 'not reported'...): escribe el dato o, si el campo es obligatorio y el estudio no lo publica, déjalo a null y decláralo en 'no_consta'",
      "description": "Texto con contenido: no vacío, no solo signos, sin caracteres invisibles ni de ancho completo y sin valores de relleno (n/a, nd, s/d, desconocido, pendiente, sin datos, not reported...), con independencia de mayúsculas, tildes y signos."
    },
    "texto_especifico": {
      "type": "string",
