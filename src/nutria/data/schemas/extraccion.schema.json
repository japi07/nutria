{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracción de datos de un estudio",
  "type": "object",
  "required": ["fuente", "especie", "diseno", "unidad_experimental", "intervencion", "variable", "unidad",
               "ubicacion"],
  "properties": {
    "fuente": {"type": "string", "pattern": "^(doi|pmid|openalex):.+"},
    "experimento": {"type": "string"},
    "especie": {"type": "string"},
    "raza": {"type": "string"},
    "sexo": {"type": "string"},
    "edad": {"type": "string"},
    "estado_fisiologico": {"type": "string"},
    "paridad": {"type": "string"},
    "diseno": {"enum": ["paralelo", "cuadrado_latino", "crossover", "factorial", "bloques", "otro"]},
    "unidad_experimental": {"enum": ["animal", "corral", "jaula", "tanque", "granja", "otro"]},
    "duracion_dias": {"type": "number", "minimum": 0},
    "dieta_basal": {"type": "string"},
    "intervencion": {"type": "string"},
    "dosis": {"type": "number"},
    "dosis_unidad": {"type": "string"},
    "dosis_base": {"type": "string", "description": "p. ej. g/animal/d, mg/kg MS, % MS"},
    "forma_producto": {"type": "string", "description": "Forma química, protección ruminal, encapsulado..."},
    "comparador": {"type": "string"},
    "variable": {"type": "string"},
    "unidad": {"type": "string"},
    "n_control": {"type": "number", "minimum": 1},
    "n_tratamiento": {"type": "number", "minimum": 1},
    "media_control": {"type": "number"},
    "media_tratamiento": {"type": "number"},
    "tipo_dispersion": {"enum": ["SD", "SE", "SEM_combinado", "SED", "IC95", "ninguno"]},
    "dispersion_control": {"type": "number", "minimum": 0},
    "dispersion_tratamiento": {"type": "number", "minimum": 0},
    "p_valor": {"type": "number", "minimum": 0, "maximum": 1},
    "ubicacion": {"type": "string", "description": "Tabla, figura (indicar si digitalizada) o página."},
    "financiacion": {"type": "string"},
    "conflictos": {"type": "string"},
    "estado_verificacion": {"enum": ["simple", "doble_concordante", "discrepancia", "resuelta"]},
    "verificado_por": {"type": "string"},
    "notas": {"type": "string"}
  }
}
